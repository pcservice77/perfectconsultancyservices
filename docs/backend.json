
{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A consultancy service. Publicly readable, admin manageable.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "description", "icon"]
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "Team leadership and staff. Publicly readable, admin manageable.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Founder", "Co-Founder", "Staff"] },
        "email": { "type": "string", "format": "email" },
        "contact": { "type": "string" },
        "profession": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "role", "email"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Customer contact submissions. Publicly creatable, admin readable.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account data and roles.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Job": {
      "title": "Job Posting",
      "description": "Careers at PCS. Publicly readable, admin manageable.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "salary": { "type": "string" }
      },
      "required": ["title", "location", "type", "salary"]
    },
    "TaxUpdate": {
      "title": "Tax Update",
      "description": "Industry news and summaries. Publicly readable, admin manageable.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "summary", "content"]
    },
    "Subscription": {
      "title": "Newsletter Subscription",
      "description": "Newsletter signups. Publicly creatable, admin readable.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "#/backend/entities/Service",
      "description": "List of consultancy services."
    },
    "/staff/{staffId}": {
      "schema": "#/backend/entities/StaffMember",
      "description": "Team members and founders."
    },
    "/enquiries/{enquiryId}": {
      "schema": "#/backend/entities/Enquiry",
      "description": "Customer enquiries."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profiles and permissions."
    },
    "/jobs/{jobId}": {
      "schema": "#/backend/entities/Job",
      "description": "Job openings."
    },
    "/taxUpdates/{taxUpdateId}": {
      "schema": "#/backend/entities/TaxUpdate",
      "description": "Tax news articles."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "#/backend/entities/Subscription",
      "description": "Newsletter subscribers."
    }
  }
}
